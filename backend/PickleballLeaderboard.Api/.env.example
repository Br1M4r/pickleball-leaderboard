# Copy this file to ".env" (same folder) for local development.
# In production, set these as environment variables on your hosting provider instead.

# Neon connection string - either form works:
#   1) URL copied from the Neon dashboard:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   2) Npgsql key/value format (takes precedence if set):
# ConnectionStrings__DefaultConnection=Host=ep-xxxx.aws.neon.tech;Database=neondb;Username=USER;Password=PASSWORD;SSL Mode=Require

# JWT signing secret - at least 32 random characters.
# Generate one:  openssl rand -base64 48   (or PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})))
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__ExpiryMinutes=480

# Comma-separated list of frontend origins allowed to call the API.
Cors__AllowedOrigins=http://localhost:5173

# First administrator - created automatically on startup if no admin exists yet.
Admin__Email=admin@example.com
Admin__Password=ChangeThisPassword123!
