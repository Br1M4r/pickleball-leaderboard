# ---- Frontend (optional) ----
# Leave empty to call the API on the same domain (/api). Only set this to use an API hosted elsewhere.
VITE_API_URL=

# ---- API (Vercel > Settings > Environment Variables) ----
# Neon connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Token lifetime in minutes (default 480)
JWT_EXPIRY_MINUTES=480
# First administrator, created automatically when no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required on Vercel so the function can read raw multipart uploads
NODEJS_HELPERS=0
