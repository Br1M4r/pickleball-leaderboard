{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: API (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/PickleballLeaderboard.Api/bin/Debug/net10.0/PickleballLeaderboard.Api.dll",
      "cwd": "${workspaceFolder}/backend/PickleballLeaderboard.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Frontend: Chrome (debug)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: dev",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + Frontend",
      "configurations": ["Backend: API (debug)", "Frontend: Chrome (debug)"],
      "stopAll": true
    }
  ]
}
